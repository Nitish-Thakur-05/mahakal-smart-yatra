# Example Environment Configuration for Mahakal Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
MONGO_URI=mongodb://127.0.0.1:27017/mahakal_db
CORS_ORIGIN=http://localhost:3000

# n8n Chatbot Webhook URL
N8N_CHAT_URL=https://your-n8n-instance.com/webhook/your-chat-trigger-id

# Automated E-Ticket SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

